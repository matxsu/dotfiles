# hyprlock — lockscreen minimaliste pour niri
# Blur énorme + horloge HH:MM:SS + date + input mdp

general {
    hide_cursor = true
    ignore_empty_input = true
}

# Fond : screenshot de l'écran actuel, énormément flouté
background {
    monitor =
    path = screenshot
    blur_passes = 4
    blur_size = 10
    noise = 0.0117
    brightness = 0.55
    vibrancy = 0.17
}

# Horloge — HH:MM:SS en énorme au centre
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M:%S"
    color = rgba(255, 255, 255, 0.95)
    font_size = 130
    font_family = monospace
    position = 0, 120
    halign = center
    valign = center
}

# Date — juste en dessous de l'heure
label {
    monitor =
    text = cmd[update:60000] date +"%A %d %B %Y"
    color = rgba(255, 255, 255, 0.7)
    font_size = 28
    font_family = monospace
    position = 0, 10
    halign = center
    valign = center
}

# Champ de mot de passe — discret, sous la date
input-field {
    monitor =
    size = 280, 48
    outline_thickness = 0
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    inner_color = rgba(0, 0, 0, 0.35)
    font_color = rgba(255, 255, 255, 0.9)
    fade_on_empty = true
    placeholder_text =
    hide_input = false
    check_color = rgba(255, 255, 255, 0.4)
    fail_color = rgba(255, 100, 100, 0.8)
    fail_text = ✕
    rounding = 12
    position = 0, -140
    halign = center
    valign = center
}
